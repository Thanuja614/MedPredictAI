{
  "dataset_name": "Hypertension Demo Dataset",
  "disease_slug": "hypertension",
  "version": "1.0.0",
  "data_classification": "SYNTHETIC DEMONSTRATION DATA \u2014 NOT REAL PATIENT DATA",
  "row_count": 400,
  "target_variable": "target",
  "features": [
    {
      "name": "age",
      "data_type": "integer",
      "min_value": 18,
      "max_value": 88,
      "unit": "years"
    },
    {
      "name": "systolic_bp",
      "data_type": "float",
      "min_value": 90.0,
      "max_value": 220.0,
      "unit": "mmHg"
    },
    {
      "name": "diastolic_bp",
      "data_type": "float",
      "min_value": 55.0,
      "max_value": 135.0,
      "unit": "mmHg"
    },
    {
      "name": "heart_rate",
      "data_type": "float",
      "min_value": 50.0,
      "max_value": 160.0,
      "unit": "bpm"
    },
    {
      "name": "bmi",
      "data_type": "float",
      "min_value": 17.0,
      "max_value": 50.0,
      "unit": "kg/m^2"
    },
    {
      "name": "cholesterol",
      "data_type": "float",
      "min_value": 120.0,
      "max_value": 380.0,
      "unit": "mg/dL"
    }
  ]
}