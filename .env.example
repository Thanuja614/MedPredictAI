# ==============================================================================
# MEDPREDICT AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets or production credentials to source control.

# Application Settings
APP_NAME="MedPredict AI"
APP_ENV="development"
APP_DEBUG=true
API_V1_STR="/api/v1"
PROJECT_VERSION="1.0.0"

# Security & Authentication
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY="medpredict_dev_secret_key_change_in_production_super_secure_32_bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL="postgresql+psycopg://medpredict_user:medpredict_pass@localhost:5432/medpredict_db"
DATABASE_TEST_URL="sqlite:///./test_medpredict.db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Cache & Message Broker (Redis)
REDIS_URL="redis://localhost:6379/0"
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Medical Safety & Risk Classification Thresholds
# Note: These are model probability thresholds, not clinical diagnosis thresholds
SYSTEM_DISCLAIMER_ENFORCED=true
RISK_THRESHOLD_MODERATE=0.35
RISK_THRESHOLD_HIGH=0.70

# Storage Paths
STORAGE_LOCAL_ROOT="./storage"
DATASETS_DIR="./data/datasets"
MODELS_DIR="./models/artifacts"
REPORTS_DIR="./reports/generated"

# Observability & Rate Limiting
LOG_LEVEL="INFO"
RATE_LIMIT_PER_MINUTE=60
